### Aplicacion
# Es la URL de base de datos a la que se va a conectar el backend, este es un valor por defecto no funcional
DATABASE_URL="postgres://usuario:password@localhost:5432/yipshare"
# Es el puerto en el que va a escuhar el backend, este es un valor por defecto
PORT=4600

### Secretos
# 32 bytes en hexadecimal. Genera uno con:
# Bun: bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# OpenSSL: openssl rand -hex 32
# Node: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Python: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# El password por defecto aplicado al administrador de la Aplicacion
ADMIN_PASSWORD=
# Un alfabeto usado para darle a los codigos de entrada a los condominos una apariencia aleatoria, no prove seguridad es puramente estetico
# Debe de contener "23456789ABCDEFGHJKLMNPQRSTUVWXYZ" en el orden que desee especificamente SIN letras minusculas.
SQIDS_ALPHABET=
# Directorio en el que se van a guardar los archivos PDF de los condominios
UPLOADS_DIR="./data/uploads"
# Directorio en el que se van a guardar los archivos de imagen de los articulos entre otros
IMAGES_DIR="./data/images"
# Directorio en el que se van a guardar los archivos de imagen para fotos de perfil
PFPS_DIR="./data/pfps"
# URL Base en la que se encuentra corriendo el backend actualmente
BASE_URL="http://localhost:4600"